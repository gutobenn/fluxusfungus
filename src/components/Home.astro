---
/**
 * The whole site is one screen: the mycelium sketch, with items and pages opening in a modal.
 * Every route (/, /p/26, /sobre, /en/...) renders this screen; `open` says which modal starts open.
 */
import "../styles/site.css";
import { clientPosts, page, plainText, ROUTES, SITE, type ClientPost, type Lang } from "../lib/content";

interface Props {
  lang: Lang;
  open?: { kind: "item"; id: string } | { kind: "page"; name: "about" | "contaminations" };
}

const { lang, open } = Astro.props;
const routes = ROUTES[lang];
const posts = await clientPosts(lang);
const pages = { about: page("sobre", lang), contaminations: page("contaminacoes", lang) };
const other: Lang = lang === "pt" ? "en" : "pt";

const openPost: ClientPost | undefined = open?.kind === "item" ? posts.find((post) => post.id === open.id) : undefined;
const openPage = open?.kind === "page" ? pages[open.name] : undefined;

let title = SITE.name;
let description = SITE.description[lang];
let image = new URL("/og_image.jpg", Astro.site).href;
if (openPage) {
  title = `${openPage.title} - ${SITE.name}`;
  description = plainText(openPage.html);
} else if (openPost) {
  if (openPost.type === "quote" && openPost.html) {
    description = plainText(openPost.html) + (openPost.author ? ` [${openPost.author}]` : "");
  } else if (openPost.type === "gallery" && openPost.pictures?.length) {
    const first = openPost.pictures[0];
    description = [first.caption, first.subcaption].filter(Boolean).join(" — ") || description;
    image = new URL(first.src, Astro.site).href;
  }
}

// Link to the same screen in the other language.
const otherRoutes = ROUTES[other];
const otherHref =
  open?.kind === "item"
    ? otherRoutes.item(open.id)
    : open?.kind === "page"
      ? otherRoutes[open.name]
      : otherRoutes.home;

const data = {
  lang,
  routes: { home: routes.home, about: routes.about, contaminations: routes.contaminations, itemPrefix: routes.item("") },
  posts,
  pages,
  open: open ?? null,
  music: SITE.music,
  analytics: SITE.analytics,
  strings:
    lang === "pt"
      ? { question: "quer som?", yes: "sim", no: "não", end: "o micélio parou por aqui", next: "mais fluxus »", restart: "rever fluxus »", close: "fechar", previous: "anterior", following: "próxima" }
      : { question: "do you want sound?", yes: "yes", no: "no", end: "the mycelium stopped here.", next: "more fluxus »", restart: "review fluxus »", close: "close", previous: "previous", following: "next" },
};
---

<!doctype html>
<html lang={lang === "pt" ? "pt-BR" : "en"}>
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="user-scalable=no, width=device-width, initial-scale=1, maximum-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" hreflang={other === "pt" ? "pt-BR" : "en"} href={new URL(otherHref, Astro.site).href} />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta name="msapplication-config" content="/favicon/browserconfig.xml" />
    <meta name="theme-color" content="#000" />
    <link rel="preload" href="/fonts/consolas-webfont.woff" as="font" type="font/woff" crossorigin />
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.analytics}`}></script>
    <script is:inline define:vars={{ id: SITE.analytics }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", id, { page_path: window.location.pathname });
    </script>
  </head>
  <body>
    <nav class="site-nav" id="site-nav">
      <div class="site-nav__inner">
        <div class="site-nav__brand">
          <a href={routes.home} class="site-title" data-route="home">fluxus fungus</a>
        </div>
        <div class="site-nav__links">
          <div class="site-nav__spacer"></div>
          <div><a href={routes.about} data-route="about">{pages.about.title}</a></div>
          <div><a href={routes.contaminations} data-route="contaminations">{pages.contaminations.title}</a></div>
          <div class="site-nav__lang">
            {lang === "pt" ? (
              <>[<span class="current">pt</span>|<a href={otherHref} hreflang="en">en</a>]</>
            ) : (
              <>[<a href={otherHref} hreflang="pt-BR">pt</a>|<span class="current">en</span>]</>
            )}
          </div>
        </div>
      </div>
    </nav>

    <main id="stage">
      <div class="sound-question" id="sound-question" hidden>
        <div class="sound-question__box">
          <div class="sound-question__text">{data.strings.question}</div>
          <div class="sound-question__buttons">
            <button type="button" data-sound="no">{data.strings.no}</button>
            <button type="button" data-sound="yes">{data.strings.yes}</button>
          </div>
        </div>
      </div>
      <div id="sketch"></div>
      <button type="button" class="sound-toggle" id="sound-toggle" hidden aria-label="som / sound">
        <svg class="icon-on" viewBox="0 0 576 512" aria-hidden="true"><path fill="currentColor" d="M215.03 71.05 126.06 160H24c-13.26 0-24 10.74-24 24v144c0 13.25 10.74 24 24 24h102.06l88.97 88.95c15.03 15.03 40.97 4.47 40.97-16.97V88.02c0-21.46-25.96-31.98-40.97-16.97zm233.32-51.08c-11.17-7.33-26.18-4.24-33.51 6.95-7.34 11.17-4.22 26.18 6.95 33.51 66.27 43.49 105.82 116.6 105.82 195.58 0 78.98-39.55 152.09-105.82 195.58-11.17 7.32-14.29 22.34-6.95 33.5 7.04 10.71 21.93 14.56 33.51 6.95C528.27 439.58 576 351.33 576 256S528.27 72.43 448.35 19.97zM480 256c0-63.53-32.06-121.94-85.77-156.24-11.19-7.14-26.03-3.82-33.12 7.46s-3.78 26.21 7.41 33.36C408.27 165.97 432 209.11 432 256s-23.73 90.03-63.48 115.42c-11.19 7.14-14.5 22.07-7.41 33.36 6.51 10.36 21.12 15.14 33.12 7.46C447.94 377.94 480 319.54 480 256zm-141.77-76.87c-11.58-6.33-26.19-2.16-32.61 9.45-6.39 11.61-2.16 26.2 9.45 32.61C327.98 228.28 336 241.63 336 256c0 14.38-8.02 27.72-20.92 34.81-11.61 6.41-15.84 21-9.45 32.61 6.43 11.66 21.05 15.8 32.61 9.45 28.23-15.55 45.77-45 45.77-76.88s-17.54-61.32-45.78-76.86z"/></svg>
        <svg class="icon-off" viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M215.03 71.05 126.06 160H24c-13.26 0-24 10.74-24 24v144c0 13.25 10.74 24 24 24h102.06l88.97 88.95c15.03 15.03 40.97 4.47 40.97-16.97V88.02c0-21.46-25.96-31.98-40.97-16.97zM461.64 256l45.64-45.64c6.3-6.3 6.3-16.52 0-22.82l-22.82-22.82c-6.3-6.3-16.52-6.3-22.82 0L416 210.36l-45.64-45.64c-6.3-6.3-16.52-6.3-22.82 0l-22.82 22.82c-6.3 6.3-6.3 16.52 0 22.82L370.36 256l-45.63 45.63c-6.3 6.3-6.3 16.52 0 22.82l22.82 22.82c6.3 6.3 16.52 6.3 22.82 0L416 301.64l45.64 45.64c6.3 6.3 16.52 6.3 22.82 0l22.82-22.82c6.3-6.3 6.3-16.52 0-22.82L461.64 256z"/></svg>
      </button>
      <audio id="music" src={SITE.music} loop preload="none"></audio>
    </main>

    <div id="modal-root"></div>

    <noscript>
      <div class="noscript">
        {openPage && <div class="markdown"><h1>{openPage.title}</h1><Fragment set:html={openPage.html} /></div>}
        {openPost?.html && <div class="markdown"><Fragment set:html={openPost.html} />{openPost.author && <p class="quote-author">[{openPost.author}]</p>}</div>}
      </div>
    </noscript>

    <script type="application/json" id="fluxus-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />
    <script>
      import "../scripts/app";
    </script>
  </body>
</html>
